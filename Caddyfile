# App image runtime (contracts/http-serving.md). TLS ends at the edge, so this serves plain HTTP
# on 8080. The global log filter keeps no request fields, and there is no log directive in the
# site block (SEC-008).
{
	admin off
	auto_https off
	servers {
		protocols h1
	}
	log {
		output stderr
		format filter {
			wrap json
			fields {
				request delete
			}
		}
	}
}

:8080 {
	root * /srv

	header {
		Content-Security-Policy "default-src 'self'; img-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# Hashed build files are immutable; everything else is revalidated on each load.
	@hashed {
		path_regexp hashed -[A-Z0-9]{8}\.(js|css|woff2)$
		file {path}
	}
	handle @hashed {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		header Cache-Control "no-cache"

		# SPA fallback only for a path with no extension and no file. A path with an extension
		# and no file answers 404, never the fallback page.
		@spa {
			not path_regexp \.[A-Za-z0-9]+$
			not file {path}
		}
		rewrite @spa /index.html

		file_server
	}
}
